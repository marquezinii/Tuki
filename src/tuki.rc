#include <windows.h>
#include "resource.h"

IDI_TUKI        ICON "..\\assets\\tuki.ico"
IDI_TUKI_PAUSED ICON "..\\assets\\tuki-paused.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "tuki.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "Tuki"
            VALUE "FileDescription", "Tuki - ajustes universais de mouse"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "Tuki"
            VALUE "OriginalFilename", "Tuki.exe"
            VALUE "ProductName", "Tuki"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
